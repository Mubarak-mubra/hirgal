# Copy these values into the deployment provider's environment settings.
# This file is documentation only; Django does not load .env files automatically.
DJANGO_SETTINGS_MODULE=config.production_settings
DJANGO_SECRET_KEY=generate-a-new-random-secret-for-production
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# PostgreSQL connection URL; use the private/internal URL from the database provider.
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSLMODE=require

# Set only after confirming the host enforces HTTPS and proxy headers are trusted.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
TRUST_X_FORWARDED_PROTO=true

# Optional AI integration key. A key can also be configured in Site Settings.
API_GEMINI=
